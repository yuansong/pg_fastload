*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.app

# Dependencies
.deps

# Binaries
bin/pg_fastload

# Generated by test suite
#
# bin/sql used to be ignored as a whole, which also excluded the inputs the
# harness copies from: the versioned sources (init-extension*.sql,
# load_*-vN.sql) and the four tests that are used verbatim.  They were
# therefore missing from the tree and CI failed at "cp: cannot stat
# 'sql/init-extension-v3.sql'".  Only the copies the Makefile generates are
# ignored now.
bin/sql/init.sql
bin/sql/*-[0-9]*.sql
bin/sql/load_bin.sql
bin/sql/load_csv.sql
bin/sql/load_filter.sql
bin/sql/load_function.sql
bin/sql/write_bin.sql
bin/regression.diffs
bin/regression.out
bin/results


# Some more
lib/exports.list
lib/pg_fastload--*.sql
lib/pg_fastload.control
util/pg_timestamp.sql
